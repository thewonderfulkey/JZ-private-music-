# ===== JZ Music .gitignore（v2 结构）=====

# 项目内工具链与 Gradle 缓存（体积大，可从 C 盘安装位置重建）
.build/

# 飞书 webhook / 应用凭据（含密钥，绝不入库）
.lark/

# 运行日志（现在默认写进项目里的 logs/，只在本机排查用，不入库）
logs/

# 冒烟测试产物（截图、uiautomator XML、logcat）
tools/smoke/out/

# 构建产物
android/app/build/
android/build/
android/.gradle/
android/.kotlin/
android/local.properties
build/
.gradle/
.kotlin/
*.apk.tmp

# JS / Node 依赖（services 为第三方仓库，依赖不入库）
node_modules/
**/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-venv/

# 第三方运行时（可从源码重建）
services/lddc/LDDC/_internal/

# IDE / 系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 临时
tmp/
scratch/
*.log
!docs/**/*.log

# 发布用的大二进制（单个 138–145 MB，超仓库单文件上限；只作为 GitHub Release 资产上传）
releases/windows/*.exe

# 桌面版构建产物（app-image / jar / 安装包都能从源码重建，不入库）
desktop/build/
desktop/.gradle/
desktop/.kotlin/

# 第三方服务源码（vendored：本地可运行、上游可重新拉取，不入本仓库）
/services/

