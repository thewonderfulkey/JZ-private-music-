# ===== JZ Music .gitignore（v2 结构）=====

# 构建产物
android/app/build/
android/build/
android/.gradle/
android/.kotlin/
android/local.properties
build/
.gradle/
.kotlin/
*.apk.tmp

# JS / Node 依赖（services 为第三方仓库，依赖不入库）
node_modules/
**/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-venv/

# 第三方运行时（可从源码重建）
services/lddc/LDDC/_internal/

# IDE / 系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 临时
tmp/
scratch/
*.log
!docs/**/*.log

# 第三方服务源码（vendored：本地可运行、上游可重新拉取，不入本仓库）
services/

